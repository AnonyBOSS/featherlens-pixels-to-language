#!/usr/bin/env bash
# Binary launcher for classification training
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PYTHON="${PROJECT_ROOT}/.venv/bin/python"

if [ ! -x "$PYTHON" ]; then
    PYTHON="$(command -v python3 || command -v python)"
fi

CONFIG_ARG=()
if [ "$#" -eq 0 ]; then
    CONFIG_ARG=("--config" "${PROJECT_ROOT}/configs/cls.yaml")
fi

export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"

exec "$PYTHON" -m src.cli train "${CONFIG_ARG[@]}" "$@"
